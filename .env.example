# ─────────────────────────────────────────────────────────────
# PMRFP environment variables. Copy to .env.local and fill in.
# The app runs without these in Phase 1 (Supabase/Stripe/email
# are wired in later phases). Nothing here is committed.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for absolute metadata / OG). Optional in dev.
NEXT_PUBLIC_SITE_URL=https://pmrfp.com

# Supabase (Phase 2) — create a project at supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 7) — products:
#   "Trade Pro Annual"  @ $249 CAD/yr   (required)
#   "Trade Pro Monthly" @  $29 CAD/mo   (optional — enables try-before-you-buy)
#   "Featured Annual"   @ $599 CAD/yr   (optional — priority placement)
# Monthly is gated by the env var: if STRIPE_PRICE_TRADE_PRO_MONTHLY is unset,
# the monthly path returns "plan not available" and the UI falls back to annual.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TRADE_PRO_ANNUAL=
STRIPE_PRICE_TRADE_PRO_MONTHLY=
STRIPE_PRICE_FEATURED_ANNUAL=
# Sponsorships (/advertise), optional. One RECURRING MONTHLY Price per tier and
# currency, made by hand in the Stripe dashboard (product "PMRFP sponsorship"):
#   province × trade $199/mo, national trade $499/mo, digest only $149/mo
#   (amounts: src/lib/sponsors/pricing.ts; CAD prices in CAD, USD prices in USD).
# Unset = that tier is enquiry-only for that currency. See docs/sponsorships.md.
STRIPE_PRICE_SPONSOR_PROVINCE_CAD=
STRIPE_PRICE_SPONSOR_PROVINCE_USD=
STRIPE_PRICE_SPONSOR_NATIONAL_CAD=
STRIPE_PRICE_SPONSOR_NATIONAL_USD=
STRIPE_PRICE_SPONSOR_DIGEST_CAD=
STRIPE_PRICE_SPONSOR_DIGEST_USD=
# Award Intelligence (src/lib/intel/pricing.ts): recurring Price IDs per interval and currency.
# Card checkout stays off until INTEL_CHECKOUT_ENABLED=true (pilot with admin grants first).
INTEL_CHECKOUT_ENABLED=
STRIPE_PRICE_INTEL_MONTHLY_CAD=
STRIPE_PRICE_INTEL_MONTHLY_USD=
STRIPE_PRICE_INTEL_ANNUAL_CAD=
STRIPE_PRICE_INTEL_ANNUAL_USD=

# Resend (Phase 8) — verify a sending domain (e.g. mail.pmrfp.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@pmrfp.com

# Insights (src/lib/insights). The Monday weekly brief for Trade Pro / trial members sends only
# when INSIGHTS_EMAIL_ENABLED=1 (then weekly-cadence members get their leads inside it instead of
# a separate lead alert). INSIGHTS_LLM=1 turns on the validator-guarded AI polish (needs GEMINI_API_KEY).
INSIGHTS_EMAIL_ENABLED=
INSIGHTS_LLM=
GEMINI_INSIGHTS_MODEL=

# PM job flow (src/lib/pm-jobs). Publishing a property-manager / landlord / GC job at /admin/rfps
# emails every matching trade (free and Pro) the same day only when PM_JOB_ALERTS_ENABLED=1; off,
# the admin sees how many would have been emailed. Commercial email: needs BUSINESS_MAILING_ADDRESS
# (CASL) and UNSUBSCRIBE_SECRET (else the service role key signs unsubscribe links).
# New posts and other admin notices go to ADMIN_NOTIFICATION_EMAIL (unset = info@pmrfp.com).
PM_JOB_ALERTS_ENABLED=
BUSINESS_MAILING_ADDRESS=
UNSUBSCRIBE_SECRET=
ADMIN_NOTIFICATION_EMAIL=

# Following buyers and towns (src/lib/follows). Free accounts follow 3 and get new listings in the
# Monday roundup; Trade Pro and trial get a same-day email (cron/buyer-follow-alerts, hourly) only when
# BUYER_FOLLOW_ALERTS_ENABLED=1. Off, /admin/buyer-sources shows a dry-run count. Same CASL needs as above.
# Page claims and "list your tenders" requests also email ADMIN_NOTIFICATION_EMAIL.
BUYER_FOLLOW_ALERTS_ENABLED=

# PMRFP for Towns, Part B2 (src/lib/town-jobs). Both default off.
# TOWN_INVITES_ENABLED=1: a town's "Invite N matching trades" and "Invite by email" really send
# (at most 50 a town per day; CASL footer, so BUSINESS_MAILING_ADDRESS is required). Off, the
# town sees how many would be sent and nothing goes out.
# TOWN_QA_EMAILS_ENABLED=1: answers to questions and addenda are emailed to everyone engaged
# with the job (and "new question" to the town). Off, they still get the in-app notice.
TOWN_INVITES_ENABLED=
TOWN_QA_EMAILS_ENABLED=

# PMRFP for Towns, Part C: the sealed quote box (src/lib/town-jobs/sealed*). Default off.
# TOWN_SEALED_EMAILS_ENABLED=1: the box's emails really send: the one-time link to a one-person
# town's named witness, "please confirm the opening" to the town's other members, and the trade's
# receipt (received / replaced / withdrawn, never the price). Off, everyone still gets the in-app
# notice, but a witness can't confirm (their link only goes out by email).
TOWN_SEALED_EMAILS_ENABLED=

# Analytics (optional). First-party tracking (/api/t, site_events, /admin/analytics)
# needs nothing here: it runs on the database and the existing server secrets.
# NEXT_PUBLIC_GA_ID: Google Analytics 4 measurement ID (G-XXXXXXXXXX), or "off". Unset,
#   production uses the built-in property (lib/tracking/ga). Loads only after cookie consent.
# NEXT_PUBLIC_CLARITY_ID: Microsoft Clarity project ID. Loads only after cookie consent.
# TRACKING_SALT_SECRET: optional secret for the daily visitor-hash salt (defaults to an
#   existing server secret).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
TRACKING_SALT_SECRET=
