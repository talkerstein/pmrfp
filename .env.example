# ─────────────────────────────────────────────────────────────
# PMRFP environment variables. Copy to .env.local and fill in.
# The app runs without these in Phase 1 (Supabase/Stripe/email
# are wired in later phases). Nothing here is committed.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for absolute metadata / OG). Optional in dev.
NEXT_PUBLIC_SITE_URL=https://pmrfp.com

# Supabase (Phase 2) — create a project at supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 7) — products:
#   "Trade Pro Annual"  @ $249 CAD/yr   (required)
#   "Trade Pro Monthly" @  $29 CAD/mo   (optional — enables try-before-you-buy)
#   "Featured Annual"   @ $599 CAD/yr   (optional — priority placement)
# Monthly is gated by the env var: if STRIPE_PRICE_TRADE_PRO_MONTHLY is unset,
# the monthly path returns "plan not available" and the UI falls back to annual.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TRADE_PRO_ANNUAL=
STRIPE_PRICE_TRADE_PRO_MONTHLY=
STRIPE_PRICE_FEATURED_ANNUAL=

# Resend (Phase 8) — verify a sending domain (e.g. mail.pmrfp.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@pmrfp.com

# Analytics (optional, Phase 10)
NEXT_PUBLIC_GA_ID=
