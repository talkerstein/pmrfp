# Same Supabase project as the web app. Anon key only — it is public by design
# and RLS is what protects the data. NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The pmrfp.com API (photo upload, AI draft, publish). Optional: defaults to
# https://pmrfp.com. Point it at a Vercel preview to test unreleased API changes.
EXPO_PUBLIC_SITE_URL=https://pmrfp.com
