{
  "expo": {
    "name": "PMRFP",
    "slug": "pmrfp",
    "scheme": "pmrfp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pmrfp.app"
    },
    "android": {
      "package": "com.pmrfp.app",
      "adaptiveIcon": {
        "backgroundColor": "#282B59",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "PMRFP uses your photos so you can add job pictures to your projects.",
          "cameraPermission": "PMRFP uses the camera so you can snap before, during and after photos of your jobs.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#282B59"
        }
      ]
    ]
  }
}
